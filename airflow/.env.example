# Copy to airflow/.env (gitignored) and fill in. See README "Orchestration with Airflow".

# Output of: id -u
AIRFLOW_UID=1000

# python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=

# openssl rand -hex 32
AIRFLOW_JWT_SECRET=

# Airflow UI login
AIRFLOW_ADMIN_USER=larry
AIRFLOW_ADMIN_PASSWORD=

# SQL Server sa password: 8+ chars with upper, lower, digit and symbol. Avoid @ : / (it goes in a URL).
FDA_DB_PASSWORD=

# Optional. Without a key, pages are 999 records and the daily request quota is lower.
OPENFDA_API_KEY=
